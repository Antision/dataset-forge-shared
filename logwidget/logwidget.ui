  <property name="styleSheet">
   <string notr="true">QWidget#LogWidget {
    background-color: rgb(11, 11, 11);
    color: #C8C8C8;
    border: none;
    font-size: 11px;
}

QPlainTextEdit {
    background-color: #111111;
    color: #C8C8C8;

    border: 1px solid #303030;
    border-radius: 5px;

    padding: 8px;

    selection-background-color: #444444;
    selection-color: #F0F0F0;

    font-size: 11px;
}

/* Focus */

QPlainTextEdit:focus {
    border: 1px solid #484848;
}

/* Disabled */

QPlainTextEdit:disabled {
    color: #666666;
    background-color: #0E0E0E;
    border-color: #252525;
}

/* ---------- ScrollBar: Vertical ---------- */

QScrollBar:vertical {
    background-color: #111111;

    width: 10px;
    margin: 3px 2px 3px 0px;

    border: none;
}

QScrollBar::handle:vertical {
    background-color: #484848;

    min-height: 28px;
    border-radius: 4px;

    margin: 1px 1px;
}

QScrollBar::handle:vertical:hover {
    background-color: #686868;
}

QScrollBar::handle:vertical:pressed {
    background-color: #858585;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ---------- ScrollBar: Horizontal ---------- */

QScrollBar:horizontal {
    background-color: #111111;

    height: 10px;
    margin: 0px 3px 2px 3px;

    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #484848;

    min-width: 28px;
    border-radius: 4px;

    margin: 1px 1px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #686868;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #858585;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ---------- QPushButton: Default ---------- */

QPushButton {
    background-color: #1A1A1A;
    color: #C8C8C8;

    border: 1px solid #383838;
    border-radius: 4px;

    padding: 6px 14px;
    min-height: 18px;

    font-size: 11px;
    font-weight: 500;
}

/* Hover */

QPushButton:hover {
    background-color: #292929;
    color: #F0F0F0;

    border: 1px solid #555555;
}

/* Pressed */

QPushButton:pressed {
    background-color: #101010;
    color: #A0A0A0;

    border: 1px solid #686868;
    padding-top: 7px;
    padding-bottom: 5px;
}

/* Keyboard Focus */

QPushButton:focus {
    border: 1px solid #686868;
}

/* Disabled */

QPushButton:disabled {
    background-color: #141414;
    color: #555555;

    border: 1px solid #262626;
}
QPushButton:checked {
    background-color: #303030;
    color: #EEEEEE;
    border: 1px solid #606060;
}

/* Error State */
QPushButton[class=&quot;error&quot;] {
    background-color: #351717;
    color: #FF7777;
    border: 1px solid #713333;
    border-radius: 4px;
    padding: 6px 14px;
}

QPushButton[class=&quot;error&quot;]:hover {
    background-color: #552020;
    color: #FF9999;
    border-color: #A34444;
}

QPushButton[class=&quot;error&quot;]:pressed {
    background-color: #281212;
    color: #E87575;
    border-color: #C65B5B;
}

QPushButton[class=&quot;error&quot;]:disabled {
    background-color: #1C1414;
    color: #765050;
    border-color: #3A2828;
}


/* Warning State */
QPushButton[class=&quot;warning&quot;] {
    background-color: #30280F;
    color: #EBC75E;
    border: 1px solid #665522;
    border-radius: 4px;
    padding: 6px 14px;
}

QPushButton[class=&quot;warning&quot;]:hover {
    background-color: #493A13;
    color: #FFDA72;
    border-color: #9A7A2B;
}

QPushButton[class=&quot;warning&quot;]:pressed {
    background-color: #25200F;
    color: #D6B650;
    border-color: #B5973D;
}

QPushButton[class=&quot;warning&quot;]:disabled {
    background-color: #19170F;
    color: #786B43;
    border-color: #393222;
}</string>
