  <property name="styleSheet">
   <string notr="true">/* 底色只挂在窗口自己身上,不再写成 QWidget{...}:
   面板(midWidget/sideWidget/info_widget)、QSplitter、QLabel 都不再自己画底,
   统一透出窗口底色 -&gt; A/B 提示色只要一条窗口规则就能整片生效,
   而且不会像裸声明那样把下面 QPushButton 的规则一起盖掉。 */
QWidget{
	background-color: rgb(11, 11, 11);
	color:white;
}
/* A/B 侧提示色:由 C++ 改动态属性 abSide(updateWindowTitleAndBackground),
   这里用属性筛选器匹配。注意 QSS 不会因属性变化自动重算,改完属性要 unpolish/polish。 */
QWidget#ImageDeduplicateWindow[abSide=&quot;A&quot;]{
	background-color: rgb(40, 40, 40);
}
QWidget#ImageDeduplicateWindow[abSide=&quot;B&quot;]{
	background-color: rgb(30, 30, 30);
}
/* 显示控件是自绘的(空图、图片留白边都是拿 palette().window() 填的),不吃上面的祖先规则,
   得单独给它一条;改属性时 C++ 里会一并 repolish(见 updateWindowTitleAndBackground)。 */
QWidget#img_display_widget{
	background-color: rgb(18, 15, 25);
}
QWidget#ImageDeduplicateWindow[abSide=&quot;A&quot;] QWidget#img_display_widget{
	background-color: rgb(40, 40, 40);
}
QWidget#ImageDeduplicateWindow[abSide=&quot;B&quot;] QWidget#img_display_widget{
	background-color: rgb(30, 30, 30);
}
QPushButton{
	color:white;
	background-color: rgb(59, 102, 93);
	border:1px solid rgb(26, 153, 132);
	padding: 2px 2px;
}
QPushButton:hover{
	background-color: rgb(85, 170, 127);
	border-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 rgba(0, 170, 0, 255), stop:1 rgba(165, 255, 69, 255));
}
QPushButton:disabled {
    color: rgb(160, 160, 160);
    background-color: rgb(65, 76, 73);
    border: 1px solid rgb(90, 105, 100);
}</string>
  </property>
